125. Valid Palindrome
class Solution {
    public boolean isPalindrome(String s) {
        boolean found=true;
        String pal=s.replaceAll("[^a-zA-Z0-9]","").toLowerCase();
        for(int i=0;i<pal.length()-1/2;i++){
            if(pal.charAt(i)!=pal.charAt(pal.length()-1-i)){
                found=false;
                break;
            }
        }
        if(found) return true;
        else return false;
    }
}
