Minimum Absolute Difference Between Two Values
class Solution {
    public int minAbsoluteDifference(int[] nums) {
        int n=nums.length;
        int min=Integer.MAX_VALUE;
        boolean found=false;
        for(int i=0;i<n;i++){
            for(int j=1;j<n;j++){
                if((nums[i]==1 && nums[j]==2) || (nums[i]==2 && nums[j]==1)){
                    found=true;
                    min=Math.min(min,Math.abs(i-j));
                }
            }
        }
        if(found) return min;
        else return -1;
    }
