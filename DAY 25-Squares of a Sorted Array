977. Squares of a Sorted Array
class Solution {
    public int[] sortedSquares(int[] nums) {
      int n=nums.length;
      int[] ans=new int[n];
      int l=0,r=n-1;
      int pos=n-1;
      while(l<=r){
        int low=nums[l]*nums[l];
        int high=nums[r]*nums[r];
        if(low>high){
            ans[pos]=low;
            l++;
        }
        else{
            ans[pos]=high;
            r--;
        }
        pos--;
      }
    return ans;
    }
}
