2965.Find Missing and Repeated Values
class Solution {
    public int[] findMissingAndRepeatedValues(int[][] grid) {
       int n=grid.length;
       int[] count=new int[n*n+1];
       for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
            count[grid[i][j]]++;
        }
       }
       int two=-1,zero=-1;
       for(int i=0;i<=n*n;i++){
       if(count[i]==2){
        two=i;
       }
       else if(count[i]==0){
        zero=i;
       }
       }
       return new int[]{two,zero};
      
    }
}
