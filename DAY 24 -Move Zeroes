283. Move Zeroes
class Solution {
    public void moveZeroes(int[] nums) {
        int n=nums.length;
        int p1=0;
        for(int i=0;i<n;i++){
            if(nums[i]!=0){
                nums[p1]=nums[i];
                 p1++;
            }
        }
        while(p1<n){
            nums[p1]=0;
            p1++;
        }
    }
}
